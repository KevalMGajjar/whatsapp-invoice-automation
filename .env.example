# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Your business (printed on every invoice) ----
BUSINESS_NAME=Sharma General Store
BUSINESS_ADDRESS=12 MG Road, Ahmedabad 380001
BUSINESS_GSTIN=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Tax applied when the message does not say "gst <n>"
DEFAULT_GST_PERCENT=0

# ---- Who may create invoices ----
# Comma-separated WhatsApp numbers in international format, digits only.
# Leave empty to allow anyone (not recommended in production).
ALLOWED_SENDERS=919876543210

# ---- WhatsApp Cloud API (Meta) ----
# Leave WHATSAPP_ACCESS_TOKEN empty to run in console mode (replies are printed).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; enter the same value in the Meta webhook setup screen.
WHATSAPP_VERIFY_TOKEN=change-me
# App secret from the Meta app dashboard; enables webhook signature checks.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# ---- Gemini (optional; used only when the built-in parser can't read a message) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Email (optional; without it invoices are generated but not emailed) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Storage ----
DATA_DIR=data
